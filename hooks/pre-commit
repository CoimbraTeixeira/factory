#!/usr/bin/env python3
"""Block commits that would publish a credential.

These repos are public, and the whole secret-handling design rests on the webhook
living in ~/.config and never entering the tree. Nothing enforced that, so one
`git add -A` of a stray config was all it took. This is the enforcement.

Scans staged content rather than the working tree: what matters is what is about to
be published, not what happens to be on disk. Bypass with `git commit --no-verify`.

`--all` scans every tracked file instead. CI runs that, because a local hook is
opt-in per clone (core.hooksPath) and skipped by --no-verify; the server-side run is
the check nothing can bypass.
"""

import re
import subprocess
import sys

# Placeholders are the common case in these repos' own READMEs
# ("https://discord.com/api/webhooks/..."), so every pattern requires
# token-shaped material rather than merely the surrounding syntax.
#
# This is a general credential scanner, not a Discord-specific one: the point is to
# catch any secret on its way into a public repo, whichever provider issued it.
PATTERNS = [
    ("Discord webhook URL",
     re.compile(r"discord(?:app)?\.com/api/webhooks/\d{17,20}/[A-Za-z0-9_-]{50,}")),
    ("Slack webhook URL",
     re.compile(r"hooks\.slack\.com/services/T[A-Za-z0-9_]{6,}/B[A-Za-z0-9_]{6,}/[A-Za-z0-9]{20,}")),
    ("Slack API token", re.compile(r"xox[baprs]-[A-Za-z0-9-]{10,}")),
    ("AWS access key id", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("GitHub token", re.compile(r"\bgh[pousr]_[A-Za-z0-9]{36,}\b")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    ("OpenAI/Anthropic key", re.compile(r"\bsk-(ant-)?[A-Za-z0-9_-]{24,}\b")),
    ("Private key block", re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----")),
    # Catches a non-Slack webhook pasted into a config blob. Requires a token-shaped
    # final path segment, so the READMEs' own ".../services/..." placeholder stays clean
    # -- a hook that blocks the documented setup steps just teaches you --no-verify.
    ("Hardcoded webhook_url value",
     re.compile(r'"webhook_url"\s*:\s*"https://\S*/[A-Za-z0-9_-]{20,}"')),
]

SKIP_SUFFIXES = (".pyc", ".zip", ".pdf", ".png", ".jpg", ".jpeg", ".gif", ".ico", ".whl")


def staged_files() -> list[str]:
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, check=True,
    ).stdout
    return [f for f in out.splitlines() if f.strip()]


def tracked_files() -> list[str]:
    out = subprocess.run(["git", "ls-files"], capture_output=True, text=True,
                         check=True).stdout
    return [f for f in out.splitlines() if f.strip()]


def staged_blob(path: str) -> str | None:
    """The staged version of the file, which is what a commit would actually publish."""
    result = subprocess.run(["git", "show", f":{path}"], capture_output=True)
    if result.returncode != 0:
        return None
    try:
        return result.stdout.decode("utf-8")
    except UnicodeDecodeError:
        return None  # binary; nothing to match against


def tracked_blob(path: str) -> str | None:
    try:
        with open(path, encoding="utf-8") as handle:
            return handle.read()
    except (OSError, UnicodeDecodeError):
        return None  # deleted in the work tree, or binary


def main() -> int:
    scan_all = "--all" in sys.argv[1:]
    paths, read = (tracked_files(), tracked_blob) if scan_all else (staged_files(), staged_blob)
    findings = []
    for path in paths:
        if path.endswith(SKIP_SUFFIXES):
            continue
        content = read(path)
        if content is None:
            continue
        for lineno, line in enumerate(content.splitlines(), start=1):
            for label, pattern in PATTERNS:
                if pattern.search(line):
                    findings.append((path, lineno, label, line.strip()[:100]))

    if not findings:
        return 0

    where = "tracked files" if scan_all else "staged changes"
    print(f"\n  BLOCKED -- possible credential in {where}\n", file=sys.stderr)
    for path, lineno, label, snippet in findings:
        print(f"  {path}:{lineno}", file=sys.stderr)
        print(f"    {label}: {snippet}", file=sys.stderr)
    print("\n  These repos are public. If this is a real credential, rotate it before", file=sys.stderr)
    print("  doing anything else -- unstaging is not enough once it has been pushed.", file=sys.stderr)
    print("  Credentials belong in ~/.config/fare-monitor/config.json (chmod 600).", file=sys.stderr)
    print("  False positive? Commit with --no-verify.\n", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
